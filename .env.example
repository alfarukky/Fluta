# Copy to .env.local (development) or .env.test (integration tests) and fill in.
# Real values are never committed. Production values live only in the host's
# environment settings. Validated at startup by src/lib/env.ts.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
# sslmode=verify-full is what node-postgres already does for "require" (and avoids
# its deprecation warning). Keep connect_timeout=15 so a Neon branch waking from
# idle does not time out.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&connect_timeout=15"

# Neon DIRECT connection string (same host WITHOUT "-pooler"). Used only by the
# Prisma CLI for migrations (prisma7.config.ts).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# The Neon branch these URLs point at: development | test | production.
# The seed refuses to run on production; integration tests require test.
DATABASE_BRANCH="development"

# Copy to .env.local (development) or .env.test (integration tests) and fill in.
# Real values are never committed. Validated at startup by src/lib/env.ts.
#
# Production: there is no .env.production. Set these in Railway's environment
# settings: DATABASE_URL, DIRECT_URL, DATABASE_BRANCH="production",
# BETTER_AUTH_SECRET, BETTER_AUTH_URL (the public https:// address, never
# localhost; the app refuses to start otherwise), the five R2_* values,
# RESEND_API_KEY, EMAIL_FROM, BOOKING_IP_SECRET, the three TERMII_* values,
# CRON_SECRET, FLUTA_ALERT_EMAIL, and PAYSTACK_MODE="live" with an sk_live_ key.
# Never set SEED_USER_PASSWORD in production.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
# sslmode=verify-full is what node-postgres already does for "require" (and avoids
# its deprecation warning). Keep connect_timeout=15 so a Neon branch waking from
# idle does not time out. Format:
# postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&connect_timeout=15
DATABASE_URL=""

# Neon DIRECT connection string (same host WITHOUT "-pooler"). Used only by the
# Prisma CLI for migrations (prisma7.config.ts). Format:
# postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15
DIRECT_URL=""

# The Neon branch these URLs point at: development | test | production.
# The seed refuses to run on production; integration tests require test.
DATABASE_BRANCH=""

# Better Auth. The secret signs session cookies: generate one per environment
# with `openssl rand -base64 32`. The URL is the app's public origin, for
# example http://localhost:3000 in development.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Password for every seeded user (development and test only; never set in
# production). Read by the seed and integration tests, not by the app.
SEED_USER_PASSWORD=""

# Cloudflare R2 (S3 API) for store logos. Use a separate bucket per environment;
# development and test never use production's. Tests replace R2 with a fake, so
# .env.test only needs placeholder values. Create an API token with Object Read
# & Write on the bucket. R2_PUBLIC_URL is the bucket's public address (r2.dev
# or a custom domain, for example https://pub-example.r2.dev). Logos are served
# from there, not through the app.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Email (Resend), for staff invitations and password resets. Create an API key
# in Resend (Sending access is enough). EMAIL_FROM must use a domain verified in
# Resend, e.g. "Fluta <noreply@yourdomain>". Tests replace the mailer with a
# fake, so .env.test only needs placeholder values. In development, send only
# to addresses you control.
RESEND_API_KEY=""
EMAIL_FROM=""

# Online booking limits count bookings per IP address. The IP is stored only as
# an HMAC keyed with this secret, never in plain form. Generate one per
# environment with `openssl rand -base64 32` (at least 32 characters).
BOOKING_IP_SECRET=""

# Customer SMS (Termii). Fluta sends every SMS from one registered sender name
# over the transactional (DND) route. Set all three or none. Without them,
# development marks messages as sent without sending them, and production
# refuses to start. TERMII_BASE_URL is your account's own base URL from the
# Termii dashboard (https). Tests never set these and never call Termii.
TERMII_API_KEY=""
TERMII_SENDER_ID=""
TERMII_BASE_URL=""

# Protects the scheduled job at /api/cron/messages (message retries and
# clearing old booking IP hashes). The host's scheduler calls it every 5
# minutes with "Authorization: Bearer <CRON_SECRET>". Generate one per
# environment with `openssl rand -base64 32` (at least 32 characters).
CRON_SECRET=""

# Where Fluta's own alerts go, for example a store reaching 80% of its daily
# booking SMS cap.
FLUTA_ALERT_EMAIL=""

# Online payments (Paystack). The secret key signs API calls and webhooks.
# Use a test key (sk_test_…, PAYSTACK_MODE="test") everywhere except
# production. A live key is refused unless NODE_ENV=production and
# DATABASE_BRANCH="production", and production refuses to start without one.
# Set both or neither: without them, online payments are unavailable.
# .env.test leaves both empty (tests use a fake Paystack client).
PAYSTACK_SECRET_KEY=""
PAYSTACK_MODE=""
